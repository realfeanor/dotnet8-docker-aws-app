<?xml version="1.0" encoding="utf-8" ?>

<log4net debug="true">
	<appender name="JsonFileLogger" type="log4net.Appender.FileAppender,log4net">
		<file value="C://Log//dockerlogs.json" />
		<layout type="Core.CrossCuttingConcerns.Logging.Log4Net.Layouts.JsonLayout, Core" ></layout>
	</appender>
	<!--<appender name="DatabaseLogger" type="log4net.Appender.AdoNetAppender">-->
	<appender name="DatabaseLogger" type="log4net.Appender.AdoNetAppender">
		<bufferSize value="1" />
		<connectionType value="Microsoft.Data.SqlClient.SqlConnection, Microsoft.Data.SqlClient" />
		<connectionString value="Server=localhost,1433;Database=Database;User=Username;Password=Password;TrustServerCertificate=True" />
		<commandText value="INSERT INTO Logs ([Detail],[Date],[Audit]) VALUES (@logDetail,@log_date,@audit)" />
		<parameter>
			<parameterName value="@logDetail" />
			<dbType value="String" />
			<size value="4000" />
			<layout type="Core.CrossCuttingConcerns.Logging.Log4Net.Layouts.JsonLayout, Core" />
		</parameter>
		<parameter>
			<parameterName value="@log_date" />
			<dbType value="DateTime" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date{yyyy-MM-dd HH:mm:ss}" />
				<!--<conversionPattern value="%date{dd-MM-yyyy HH:mm:ss:fff}" />-->

			</layout>
			<!--<layout type="log4net.Layout.PatternLayout" value="%date{dd'-'MM'-'yyyy HH':'mm':'ss'.'fff}" />-->
		</parameter>
		<parameter>
			<parameterName value="@audit" />
			<dbType value="String" />
			<size value="50" />
			<layout type="log4net.Layout.PatternLayout" value="%level" />
		</parameter>
	</appender>

	<logger name="JsonFileLogger">
		<level value="ALL"></level>
		<appender-ref ref="JsonFileLogger"/>
	</logger>

	<logger name="DatabaseLogger">
		<level value="ALL"></level>
		<appender-ref ref="DatabaseLogger"/>
	</logger>

</log4net>
